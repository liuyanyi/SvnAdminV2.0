# Build the existing Vue 2 frontend with its compatible Node toolchain.
FROM node:14 AS builder

WORKDIR /app
COPY 01.web/ ./
RUN npm install && npm run build

# Debian 13 supplies PHP 8.4 from its official repositories.
FROM debian:13-slim

ENV TZ=Asia/Shanghai \
    LANG=en_US.UTF-8 \
    DEBIAN_FRONTEND=noninteractive

COPY 02.php/ /var/www/html/
COPY 03.cicd/svnadmin_docker/start-debian.sh /root/start.sh
COPY 03.cicd/svnadmin_docker/data/ /home/svnadmin/
COPY 03.cicd/svnadmin_docker/data/ /opt/svnadmin-seed/

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        locales ca-certificates curl gnupg uuid-runtime procps unzip zip \
        apache2 subversion libapache2-mod-svn subversion-tools \
        php8.4-cli php8.4-common libapache2-mod-php8.4 \
        php8.4-mysql php8.4-sqlite3 php8.4-gd php8.4-bcmath \
        php8.4-ldap php8.4-mbstring php8.4-curl php8.4-xml \
        sasl2-bin libsasl2-modules libsasl2-modules-ldap cron at; \
    ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime; \
    echo "$TZ" > /etc/timezone; \
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen; \
    locale-gen; \
    mkdir -p /home/svnadmin/backup /home/svnadmin/crond \
        /home/svnadmin/rep /home/svnadmin/temp /home/svnadmin/logs \
        /home/svnadmin/sasl/ldap \
        /home/svnadmin/templete/initStruct/01/branches \
        /home/svnadmin/templete/initStruct/01/tags \
        /home/svnadmin/templete/initStruct/01/trunk; \
    mkdir -p /etc/httpd/conf.d /run/httpd; \
    ln -s /usr/lib/apache2/modules /etc/httpd/modules; \
    ln -s /usr/sbin/apache2ctl /usr/sbin/httpd; \
    ln -s /run/apache2/apache2.pid /run/httpd/httpd.pid; \
    printf 'IncludeOptional /etc/httpd/conf.d/*.conf\n' \
        > /etc/apache2/conf-available/httpd-conf-d-compat.conf; \
    a2enconf httpd-conf-d-compat; \
    a2dismod mpm_event; \
    a2enmod mpm_prefork php8.4 dav dav_svn rewrite; \
    chmod +x /root/start.sh; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/dist/ /var/www/html/

EXPOSE 80 443 3690

CMD ["/root/start.sh"]
